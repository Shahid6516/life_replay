# ==============================
# Dependencies
# ==============================
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# ==============================
# Environment & Secrets (Crucial)
# ==============================
.env
.env*.local
.env.production
.env.development
.env.test

# ==============================
# Next.js Build Outputs & Cache
# ==============================
.next/
/out/
/build
/dist

# ==============================
# Prisma & SQLite (Local files)
# ==============================
# Ignore local SQLite databases if ever used
*.db
*.db-journal

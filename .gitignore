# TypeScript & Testing
# ==============================
*.tsbuildinfo
next-env.d.ts
coverage/
.nyc_output/

# ==============================
# Package Manager Logs
# ==============================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================
# IDE & System Files
# ==============================
.DS_Store
*.pem
Thumbs.db
.idea/
.vscode/*
